{
  "name": "dsh-readme-reel",
  "version": "0.1.0",
  "description": "Turn a plugin repo's screenshots into a 6-second silent looping hero reel (transparent-background webm + gif + cover frame) for README first screens and plugin marketplace entries.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-readme-reel": "bin/reel.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "audit": "node scripts/audit.mjs",
    "reel": "node bin/reel.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "readme",
    "gif",
    "webm",
    "screencast",
    "reel",
    "marketplace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-readme-reel.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-readme-reel#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-readme-reel/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
